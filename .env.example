# Supabase: Project Settings > Data API (URL) e API Keys (chaves).
# Chaves novas (sb_publishable_ / sb_secret_) ou legadas (anon / service_role) funcionam.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Secreta! Só no servidor. Nunca exponha no front nem faça commit.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo para assinar os QR Codes (comanda e passe de saída). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres

# Só para os scripts locais (db:schema, db:migrar, db:limpar). NÃO cadastre na Vercel.
# Supabase > botão Connect > Connection String (Direct ou Session pooler), com a senha do banco.
# Se a senha tiver caracteres especiais, codifique-os (ex.: ! vira %21).
DATABASE_URL=postgresql://postgres:SUA-SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
